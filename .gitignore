# 敏感文件
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 运行时生成的目录
uploads/
outputs/
vector_store/

# 前端依赖
node_modules/
frontend/node_modules/

# 前端构建产物（每次 build 都会变 hash，污染历史，不上传）
frontend/dist/
dist/

# WorkBuddy 会话记录
.workbuddy/

# 知识库
knowledge_base/

# 日志和统计
*.log
stats.json

# 数据库文件（每个开发者本地独立）
*.db

# 数据目录：仅保留占位文件
backend/data/*
!backend/data/.gitkeep

# 系统文件
.DS_Store
Thumbs.db